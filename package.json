{
  "name": "tavolato",
  "version": "0.0.0",
  "description": "A small Parquet writer, and a reader for the files it writes, that works anywhere.",
  "keywords": [
    "analytics",
    "columnar-storage",
    "javascript",
    "parquet",
    "parquet-reader",
    "parquet-writer",
    "runtime-agnostic",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandros94/tavolato.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./uns3": {
      "types": "./dist/uns3.d.mts",
      "default": "./dist/uns3.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub && pnpm simple-git-hooks",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run --slowTestThreshold=1000",
    "test:coverage": "vitest run --coverage --slowTestThreshold=1000",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "automd": "^0.4.3",
    "obuild": "^0.4.38",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "uns3": "^0.0.8",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "uns3": "^0.0.8"
  },
  "peerDependenciesMeta": {
    "uns3": {
      "optional": true
    }
  },
  "resolutions": {
    "tavolato": "link:."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm build --stub && pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.17.0"
}
